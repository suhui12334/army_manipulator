<?xml version="1.0"?>
<!--
  ros2_control 하드웨어 인터페이스 정의
  ============================================================
  use_mock_hardware=true  (기본값, 하드웨어 인터페이스 검증 전)
    -> mock_components/GenericSystem 로 5축 전부를 하나의 system 으로 노출.
       RViz + MoveIt2 플래닝 파이프라인 검증용.

  use_mock_hardware=false (실제 하드웨어)
    -> dolbotZ(9o9hz/dolbotZ)에서 검증된 플러그인/파라미터 구조를 그대로 이식:
       - base_joint + gripper_joint : dynamixel_hardware_interface/DynamixelHardware
         (하나의 system, TTL 버스 하나에 ID로 구분. gripper=ID4, base=ID0 실측값)
       - shoulder/elbow/wrist       : rmd_hardware_interface/MyActuatorRmdHardwareInterface
         (CAN, 조인트당 개별 actuator 블록)
  ============================================================
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="army_manipulator_ros2_control" params="prefix use_mock_hardware">

    <xacro:arg name="dxl_port_name" default="/dev/ttyUSB0"/>
    <xacro:arg name="dxl_baud_rate" default="57600"/>
    <xacro:arg name="rmd_ifname" default="can_arm"/>
    <xacro:arg name="rmd_timeout" default="100"/>

    <xacro:if value="${use_mock_hardware}">

      <ros2_control name="${prefix}army_manipulator_system" type="system">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
        </hardware>
        <joint name="${prefix}base_joint">
          <command_interface name="position"/>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}shoulder_lift_joint">
          <command_interface name="position"/>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}elbow_joint">
          <command_interface name="position"/>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}wrist_joint">
          <command_interface name="position"/>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}gripper_joint">
          <command_interface name="position"/>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}rack_left_joint">
          <param name="mimic">${prefix}gripper_joint</param>
          <param name="multiplier">${pinion_pitch_radius}</param>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}rack_right_joint">
          <param name="mimic">${prefix}gripper_joint</param>
          <param name="multiplier">${-pinion_pitch_radius}</param>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>

    </xacro:if>

    <xacro:unless value="${use_mock_hardware}">

      <!-- ===== base_joint(XH540, ID0) + gripper_joint(MX-106T, ID4) : 하나의 TTL 버스 ===== -->
      <ros2_control name="${prefix}dynamixel_system" type="system">
        <hardware>
          <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
          <param name="port_name">$(arg dxl_port_name)</param>
          <param name="baud_rate">$(arg dxl_baud_rate)</param>
          <param name="dynamixel_model_folder">/param/dxl_model</param>
          <param name="number_of_joints">2</param>
          <param name="number_of_transmissions">2</param>
          <param name="disable_torque_at_init">true</param>
          <param name="error_timeout_ms">1000</param>
          <param name="transmission_to_joint_matrix">1,0,0,1</param>
          <param name="joint_to_transmission_matrix">1,0,0,1</param>
          <param name="dynamixel_state_pub_msg_name">dynamixel_hardware_interface/dxl_state</param>
          <param name="get_dynamixel_data_srv_name">dynamixel_hardware_interface/get_dxl_data</param>
          <param name="set_dynamixel_data_srv_name">dynamixel_hardware_interface/set_dxl_data</param>
          <param name="reboot_dxl_srv_name">dynamixel_hardware_interface/reboot_dxl</param>
          <param name="set_dxl_torque_srv_name">dynamixel_hardware_interface/set_dxl_torque</param>
        </hardware>
        <!-- joint/gpio 순서가 transmission_to_joint_matrix(항등행렬)로 1:1 매핑되므로
             순서를 반드시 gripper -> base 로 맞춘다 (dolbotZ 실측 순서와 동일). -->
        <joint name="${prefix}gripper_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <joint name="${prefix}base_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <gpio name="dxl1">
          <param name="type">dxl</param>
          <param name="ID">4</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Present Current"/>
          <state_interface name="Torque Enable"/>
          <state_interface name="Hardware Error Status"/>
          <param name="Return Delay Time">0</param>
        </gpio>
        <gpio name="dxl2">
          <param name="type">dxl</param>
          <param name="ID">0</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Present Current"/>
          <state_interface name="Torque Enable"/>
          <state_interface name="Hardware Error Status"/>
          <param name="Return Delay Time">0</param>
        </gpio>
      </ros2_control>

      <!-- ===== shoulder_lift_joint : RMD-X8-120 (CAN, ID4) ===== -->
      <ros2_control name="${prefix}shoulder_actuator" type="actuator">
        <hardware>
          <plugin>rmd_hardware_interface/MyActuatorRmdHardwareInterface</plugin>
          <param name="ifname">$(arg rmd_ifname)</param>
          <param name="actuator_id">4</param>
          <!-- TODO(rmd-tuning): torque_constant/max_velocity/current 관련 값은
               RMD-X8-120 데이터시트 기준 임시값. 실측 후 조정 필요. -->
          <param name="torque_constant">1.0</param>
          <param name="max_velocity">1.047</param>
          <param name="velocity_alpha">0.1</param>
          <param name="effort_alpha">0.1</param>
          <param name="software_current_limit">10.0</param>
          <param name="current_release_threshold">8.0</param>
          <param name="current_limit_duration_ms">50</param>
          <param name="current_retreat_velocity">0.1</param>
          <param name="current_max_retreat_distance">0.174533</param>
          <param name="timeout">$(arg rmd_timeout)</param>
        </hardware>
        <joint name="${prefix}shoulder_lift_joint">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </ros2_control>

      <!-- ===== elbow_joint : RMD-X6-60 (CAN, ID5) ===== -->
      <ros2_control name="${prefix}elbow_actuator" type="actuator">
        <hardware>
          <plugin>rmd_hardware_interface/MyActuatorRmdHardwareInterface</plugin>
          <param name="ifname">$(arg rmd_ifname)</param>
          <param name="actuator_id">5</param>
          <param name="torque_constant">1.0</param>
          <param name="max_velocity">1.571</param>
          <param name="velocity_alpha">0.1</param>
          <param name="effort_alpha">0.1</param>
          <param name="software_current_limit">10.0</param>
          <param name="current_release_threshold">8.0</param>
          <param name="current_limit_duration_ms">50</param>
          <param name="current_retreat_velocity">0.1</param>
          <param name="current_max_retreat_distance">0.174533</param>
          <param name="timeout">$(arg rmd_timeout)</param>
        </hardware>
        <joint name="${prefix}elbow_joint">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </ros2_control>

      <!-- ===== wrist_joint : RMD-X4-36 (CAN, ID6) ===== -->
      <ros2_control name="${prefix}wrist_actuator" type="actuator">
        <hardware>
          <plugin>rmd_hardware_interface/MyActuatorRmdHardwareInterface</plugin>
          <param name="ifname">$(arg rmd_ifname)</param>
          <param name="actuator_id">6</param>
          <param name="torque_constant">1.0</param>
          <param name="max_velocity">2.618</param>
          <param name="velocity_alpha">0.1</param>
          <param name="effort_alpha">0.1</param>
          <param name="software_current_limit">10.0</param>
          <param name="current_release_threshold">8.0</param>
          <param name="current_limit_duration_ms">50</param>
          <param name="current_retreat_velocity">0.1</param>
          <param name="current_max_retreat_distance">0.174533</param>
          <param name="timeout">$(arg rmd_timeout)</param>
        </hardware>
        <joint name="${prefix}wrist_joint">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </ros2_control>

    </xacro:unless>

  </xacro:macro>

</robot>