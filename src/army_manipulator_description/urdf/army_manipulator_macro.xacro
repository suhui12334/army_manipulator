<?xml version="1.0"?>
<!--
  MARU 로봇팔 매크로 (수정본)
  ============================================================
  확정 파라미터 (베이스 상판 기준, prefix + parent 하위에 전개됨):
    베이스→숄더 관절축 (sh_off)   = 106.6 mm
    L1 숄더→엘보우                = 180 mm
    L2 엘보우→리스트               = 220 mm
    L3 리스트→TCP                 = 220 mm
    TCP 오프셋 (gripper_base_link → tcp_link) = 65 mm

    Case C 조인트 오프셋 (z축):
      shoulder_lift : -37.7 mm
      elbow         : +18.8 mm
      wrist         : -31.3 mm
      gripper       : +38 mm

  조인트 리미트:
    기존에 이 파일에 하드코딩돼 있던 가정치(base ±180°, shoulder 0~120°,
    elbow -90~+20°, wrist ±120°, gripper ±135° 등)는 전부 실측 인코더 기준
    리미트로 대체되었다. 실제 <limit> 값은 config/joint_calibration.yaml의
    raw_min/raw_max/zero_offset을 아래 보정식으로 계산해서 사용한다:

      actual_joint_angle = raw_encoder_angle - zero_offset
      actual_limit       = raw_limit         - zero_offset

    zero_offset은 아직 실측 전이라 joint_calibration.yaml에 전부 0.0
    placeholder로 들어있다(TODO(zero-offset)). 실측 후에는 그 yaml 파일만
    갱신하면 되고, 이 xacro는 손댈 필요 없다.

  TODO(home-pose): 각 조인트의 기본자세(홈 포지션, 현재는 SRDF group_state
  "home"에서 전부 actual=0으로 둠)는 아직 CATIA 확인 전 플레이스홀더다.
  TODO(base-pan-axis): base_rotate_joint의 회전축 방향/장착 orientation은
  CATIA로 재확인 필요.
  ============================================================
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="army_manipulator" params="prefix parent use_mock_hardware:=true use_mesh:=false">

    <!-- ========== 치수 파라미터 ========== -->
    <xacro:property name="sh_off"   value="0.1616"/>  <!-- base_link -> shoulder_pan_link -->
    <xacro:property name="L1"       value="0.180"/>   <!-- shoulder -> elbow -->
    <xacro:property name="L2"       value="0.220"/>   <!-- elbow -> wrist -->
    <xacro:property name="L3"       value="0.220"/>   <!-- wrist -> tcp (gripper 포함) -->
    <xacro:property name="off_shoulder" value="-0.0377"/>
    <xacro:property name="off_elbow"    value="0.0188"/>
    <xacro:property name="off_wrist"    value="-0.0313"/>
    <xacro:property name="off_gripper"  value="0.038"/>
    <xacro:property name="tcp_off"      value="0.065"/> <!-- gripper_base_link -> tcp_link -->

    <!-- ========== 관절 영점 보정(zero-offset) 리미트 로드 ========== -->
    <xacro:arg name="joint_calibration_file"
               default="$(find army_manipulator_description)/config/joint_calibration.yaml"/>
    <xacro:property name="joint_calibration_file" value="$(arg joint_calibration_file)"/>
    <xacro:property name="joint_calib" value="${xacro.load_yaml(joint_calibration_file)}"/>

    <xacro:property name="base_limit_lower"
                     value="${joint_calib['joints']['base_joint']['raw_min'] - joint_calib['joints']['base_joint']['zero_offset']}"/>
    <xacro:property name="base_limit_upper"
                     value="${joint_calib['joints']['base_joint']['raw_max'] - joint_calib['joints']['base_joint']['zero_offset']}"/>
    <xacro:property name="shoulder_lift_limit_lower"
                     value="${joint_calib['joints']['shoulder_lift_joint']['raw_min'] - joint_calib['joints']['shoulder_lift_joint']['zero_offset']}"/>
    <xacro:property name="shoulder_lift_limit_upper"
                     value="${joint_calib['joints']['shoulder_lift_joint']['raw_max'] - joint_calib['joints']['shoulder_lift_joint']['zero_offset']}"/>
    <xacro:property name="elbow_limit_lower"
                     value="${joint_calib['joints']['elbow_joint']['raw_min'] - joint_calib['joints']['elbow_joint']['zero_offset']}"/>
    <xacro:property name="elbow_limit_upper"
                     value="${joint_calib['joints']['elbow_joint']['raw_max'] - joint_calib['joints']['elbow_joint']['zero_offset']}"/>
    <xacro:property name="wrist_limit_lower"
                     value="${joint_calib['joints']['wrist_joint']['raw_min'] - joint_calib['joints']['wrist_joint']['zero_offset']}"/>
    <xacro:property name="wrist_limit_upper"
                     value="${joint_calib['joints']['wrist_joint']['raw_max'] - joint_calib['joints']['wrist_joint']['zero_offset']}"/>
    <xacro:property name="gripper_limit_lower"
                     value="${joint_calib['joints']['gripper_joint']['raw_min'] - joint_calib['joints']['gripper_joint']['zero_offset']}"/>
    <xacro:property name="gripper_limit_upper"
                     value="${joint_calib['joints']['gripper_joint']['raw_max'] - joint_calib['joints']['gripper_joint']['zero_offset']}"/>

    <!-- ========== parent -> base_link ========== -->
    <joint name="${prefix}world_to_base" type="fixed">
      <parent link="${parent}"/>
      <child  link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- base_link: 암 마운팅 플레이트 (구동부 상면) -->
    <link name="${prefix}base_link">
      <xacro:if value="${use_mesh}">
        <!-- [시각화] X축 -90° 회전 + Z축 +9.08° 보정.
             base_link.stl 삼각형 normal을 직접 계산해보면 원판 주면(제일 넓은
             평면, ~27000mm^2)의 native normal이 (0.9874, 0, -0.1578)로 순수
             +X에서 9.08° 벗어나 있다(STL 자체에 실제로 모델링된 tilt, 로딩/렌더링
             아티팩트 아님). X축 -90° 적용 후에는 이 tilt가 XY평면 상의 편차로
             나타나(rendered normal (0.9874,-0.1578,0)) 원판이 YZ평면에서 살짝
             돌아가 보였다. Z축으로 +9.08°(atan2(0.1578,0.9874)) 추가 보정하면
             정확히 (1,0,0)이 되어 원판이 YZ평면에 평평하게 눕는다. -->
        <visual>
          <origin xyz="0 0 0" rpy="${-pi/2} 0 0.15847"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="petg_grey"/>
        </visual>
        <!-- [콜리전] visual과 동일 회전. -->
        <collision>
          <origin xyz="0 0 0" rpy="${-pi/2} 0 0.15847"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><box size="0.100 0.100 0.008"/></geometry>
          <material name="petg_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><box size="0.100 0.100 0.008"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="2.5e-4" ixy="0" ixz="0" iyy="2.5e-4" iyz="0" izz="5.0e-4"/>
      </inertial>
    </link>

    <!-- ========== base_link -> shoulder_pan_link ========== -->
    <!-- XH540-W270-T | Z축 회전 (베이스 선회) -->
    <joint name="${prefix}base_rotate_joint" type="revolute">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}shoulder_pan_link"/>
      <origin xyz="0 0 ${sh_off}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <!-- 실측 인코더 리미트(raw_min/raw_max) - zero_offset. config/joint_calibration.yaml -->
      <limit lower="${base_limit_lower}" upper="${base_limit_upper}"
             effort="3.1" velocity="2.618"/>
      <!-- XH540 stall torque 3.1 Nm @ 12V, no-load speed 25 RPM = 2.618 rad/s -->
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <!-- shoulder_pan_link: XH540 모터 바디 (mesh: base_actuator.stl) -->
    <link name="${prefix}shoulder_pan_link">
      <xacro:if value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/base_actuator.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="motor_dark"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/base_actuator.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><cylinder radius="0.028" length="0.055"/></geometry>
          <material name="motor_dark"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><cylinder radius="0.028" length="0.055"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.202"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1.3e-4" ixy="0" ixz="0"
                 iyy="1.3e-4" iyz="0" izz="8.0e-5"/>
      </inertial>
    </link>

    <!-- ========== shoulder_pan_link -> upper_arm_link ========== -->
    <!-- RMD-X8-120 | Y축 회전 (숄더 피치), Case C 오프셋 z=-37.7mm -->
    <joint name="${prefix}shoulder_lift_joint" type="revolute">
      <parent link="${prefix}shoulder_pan_link"/>
      <child  link="${prefix}upper_arm_link"/>
      <origin xyz="0 0 ${off_shoulder}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- 실측 인코더 리미트(raw_min/raw_max) - zero_offset. config/joint_calibration.yaml -->
      <limit lower="${shoulder_lift_limit_lower}" upper="${shoulder_lift_limit_upper}"
             effort="120.0" velocity="1.047"/>
      <!-- RMD-X8-120 peak torque 120 Nm, no-load speed ~10 RPM = 1.047 rad/s -->
      <dynamics damping="1.0" friction="0.1"/>
    </joint>

    <!-- upper_arm_link: RMD-X8-120 출력 플랜지 + L1 CFRP 튜브 + RMD-X6-60 케이스 통합 파츠 (mesh: shoulder_link.stl) -->
    <link name="${prefix}upper_arm_link">
      <xacro:if value="${use_mesh}">
        <!-- [시각화] X축 -90° + Z축 180° 회전 적용. -->
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/shoulder_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="cfrp"/>
        </visual>
        <!-- [콜리전] visual과 동일 회전. -->
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/shoulder_link.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="0 ${-L1/2} 0" rpy="1.5708 0 0"/>
          <geometry><box size="0.020 0.020 ${L1}"/></geometry>
          <material name="cfrp"/>
        </visual>
        <collision>
          <origin xyz="0 ${-L1/2} 0" rpy="0 0 0"/>
          <geometry><box size="0.022 ${L1} 0.022"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.08"/>
        <origin xyz="${L1/2} 0 0"/>
        <inertia ixx="6.0e-6" ixy="0" ixz="0"
                 iyy="2.2e-4" iyz="0" izz="2.2e-4"/>
      </inertial>
    </link>

    <!-- ========== upper_arm_link -> forearm_link ========== -->
    <!-- RMD-X6-60 | Y축 회전 (엘보우 피치), x=L1, Case C 오프셋 z=+18.8mm -->
    <joint name="${prefix}elbow_joint" type="revolute">
      <parent link="${prefix}upper_arm_link"/>
      <child  link="${prefix}forearm_link"/>
      <origin xyz="${L1} 0 ${off_elbow}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- 실측 인코더 리미트(raw_min/raw_max) - zero_offset. config/joint_calibration.yaml -->
      <limit lower="${elbow_limit_lower}" upper="${elbow_limit_upper}"
             effort="60.0" velocity="1.571"/>
      <!-- RMD-X6-60 peak torque 60 Nm -->
      <dynamics damping="0.5" friction="0.05"/>
    </joint>

    <!-- forearm_link: RMD-X6-60 출력 플랜지 + L2 CFRP 튜브 + RMD-X4-36 케이스 통합 파츠 (mesh: elbow_link.stl) -->
    <link name="${prefix}forearm_link">
      <xacro:if value="${use_mesh}">
        <!-- [시각화] X축 -90° 회전 적용. -->
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/elbow_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="cfrp"/>
        </visual>
        <!-- [콜리전] visual과 동일 회전. -->
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/elbow_link.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="0 ${-L2/2} 0" rpy="1.5708 0 0"/>
          <geometry><box size="0.020 0.020 ${L2}"/></geometry>
          <material name="cfrp"/>
        </visual>
        <collision>
          <origin xyz="0 ${-L2/2} 0" rpy="0 0 0"/>
          <geometry><box size="0.022 ${L2} 0.022"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.10"/>
        <origin xyz="${L2/2} 0 0"/>
        <inertia ixx="7.3e-6" ixy="0" ixz="0"
                 iyy="4.0e-4" iyz="0" izz="4.0e-4"/>
      </inertial>
    </link>

    <!-- ========== forearm_link -> wrist_link ========== -->
    <!-- RMD-X4-36 | Y축 회전 (리스트 피치), x=L2, Case C 오프셋 z=-31.3mm -->
    <joint name="${prefix}wrist_joint" type="revolute">
      <parent link="${prefix}elbow_link"/>
      <child  link="${prefix}wrist_link"/>
      <origin xyz="${L2} 0 ${off_wrist}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- 실측 인코더 리미트(raw_min/raw_max) - zero_offset. config/joint_calibration.yaml -->
      <limit lower="${wrist_limit_lower}" upper="${wrist_limit_upper}"
             effort="36.0" velocity="2.618"/>
      <!-- RMD-X4-36 peak torque 36 Nm -->
      <dynamics damping="0.2" friction="0.02"/>
    </joint>

    <!-- wrist_link: 리스트 모터 하우징 (PETG) -->
    <link name="${prefix}wrist_link">
      <xacro:if value="${use_mesh}">
        <!-- [시각화] X축 -90° 회전 적용. -->
        <visual>
          <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/wrist_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="petg_grey"/>
        </visual>
        <!-- [콜리전] visual과 동일 회전. -->
        <collision>
          <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/wrist_link.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><cylinder radius="0.022" length="0.038"/></geometry>
          <material name="petg_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><cylinder radius="0.022" length="0.038"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.09"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="5.0e-5" ixy="0" ixz="0" iyy="5.0e-5" iyz="0" izz="3.0e-5"/>
      </inertial>
    </link>

    <!-- ========== wrist_link -> cam_link (fixed, RealSense D435i 마운트) ==========
         [수정] 뎁스카메라-TCP 캘리브레이션 실측값으로 재정의: "TCP 기준 Z축 -70mm,
         Y축(높이) +100mm, X축 하단 -15° 틸트". TCP는 gripper_joint에 종속된
         gripper_base_link의 자식(tcp_joint)이라 그 자체는 회전하지만, 카메라 브라켓은
         wrist_link에 고정된 채 그리퍼 회전과 무관하게 정지해 있어야 하므로,
         "TCP 기준"은 gripper_joint=0(정지 자세)일 때의 TCP 위치를 물리적
         측정 기준점으로 삼았다는 뜻이다. 그 순간 wrist_link -> tcp_link
         변위(회전 없음, gripper_joint=0이라 순수 평행이동) = gripper_joint
         origin(0, 0, off_gripper) + tcp_joint origin(0, 0, tcp_off)
         = (0, 0, off_gripper+tcp_off). 여기에 카메라의 TCP 기준 오프셋을 더한다:
         - Z(전면) -70mm: TCP보다 70mm 뒤쪽(가리키는 방향의 반대) → z = off_gripper+tcp_off-0.070
         - Y(하단) +100mm 높이: 이 프로젝트 관례상 -Y가 "위" 방향이므로 y = -0.100
         - X: 지정 없음 → wrist_link와 동일 선상
         rpy: 카메라가 전면(+Z)에서 하단(+Y) 쪽으로 15° 숙여져야 하므로(하향
         틸트), X축 기준 음의 회전 -0.2618 rad(=-15°) - 기존과 동일값, 변경 없음.
         (cam_link의 mesh 내부 origin(0.020 0.029 0)은 STL 자체의 bbox-center
         보정값이라 마운트 위치가 바뀌어도 그대로 유지한다.) -->
    <joint name="${prefix}cam_mount_joint" type="fixed">
      <parent link="${prefix}wrist_link"/>
      <child  link="${prefix}cam_link"/>
      <origin xyz="0 -0.100 ${off_gripper + tcp_off - 0.070}" rpy="-0.2618 0 0"/>
    </joint>

    <!-- cam_link: RealSense D435i 마운트 브라켓 (PETG, 15° 쐐기형 고정) -->
    <link name="${prefix}cam_link">
      <xacro:if value="${use_mesh}">
        <!-- [시각화] X축 -90° + Y축 180° 회전 적용 (틸트는 cam_mount_joint의 origin에서 별도 처리).
             origin xyz는 위 좌표계 이동을 상쇄해서 mesh의 절대 렌더링 위치를 그대로 유지. -->
        <visual>
          <origin xyz="0.020 0.029 0" rpy="-${pi/2} 0 ${pi}"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/cam_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="petg_grey"/>
        </visual>
        <!-- [콜리전] visual과 동일. -->
        <collision>
          <origin xyz="0.020 0.029 0" rpy="-${pi/2} 0 ${pi}"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/cam_link.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><box size="0.025 0.090 0.025"/></geometry>
          <material name="petg_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><box size="0.025 0.090 0.025"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.072"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="3.0e-5" ixy="0" ixz="0" iyy="5.0e-6" iyz="0" izz="3.0e-5"/>
      </inertial>
    </link>

    <!-- ========== wrist_link -> gripper_base_link ========== -->
    <!-- MX-106T | Z축 회전 (그리퍼 회전/핑거 구동), Case C 오프셋 z=+38mm -->
    <joint name="${prefix}gripper_joint" type="revolute">
      <parent link="${prefix}wrist_link"/>
      <child  link="${prefix}gripper_base_link"/>
      <origin xyz="0 0 ${off_gripper}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${gripper_limit_lower}" upper="${gripper_limit_upper}" effort="8.4" velocity="3.665"/>
      <dynamics damping="0.05" friction="0.01"/>
    </joint>

    <!-- gripper_base_link: EE 바디 + 핑거 어셈블리 (mesh: pinion_gear.stl) -->
    <link name="${prefix}gripper_base_link">
      <xacro:if value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/pinion_gear.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="motor_dark"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/pinion_gear.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0.110" rpy="0 0 0"/>
          <geometry><box size="0.040 0.095 0.182"/></geometry>
          <!-- 너비 95mm = 95x95x95 타겟 기준 최대 개구량 -->
          <material name="petg_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0.110" rpy="0 0 0"/>
          <geometry><box size="0.040 0.095 0.182"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.15"/>
        <origin xyz="0 0 0.110"/>
        <inertia ixx="5.0e-4" ixy="0" ixz="0"
                 iyy="5.0e-4" iyz="0" izz="1.0e-4"/>
      </inertial>
    </link>

    <!-- ========== gripper_base_link -> tcp_link (fixed) ========== -->
    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child  link="${prefix}tcp_link"/>
      <origin xyz="0 0 ${tcp_off}" rpy="0 0 0"/>
    </joint>

    <!-- tcp_link: 툴 센터 포인트 (mesh 없음, primitive만 사용) -->
    <link name="${prefix}tcp_link">
      <!-- [시각화] 구는 회전 불변이라 rpy 의미 없음. -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.005"/></geometry>
        <material name="tcp_red"/>
      </visual>
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
      </inertial>
    </link>

    <xacro:army_manipulator_ros2_control prefix="${prefix}" use_mock_hardware="${use_mock_hardware}"/>

  </xacro:macro>

</robot>