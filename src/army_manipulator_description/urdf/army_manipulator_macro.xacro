<?xml version="1.0"?>
<!--
  MARU 로봇팔 매크로
  ============================================================
  확정 파라미터 (베이스 상판 기준, prefix + parent 하위에 전개됨):
    베이스→숄더 관절축 (sh_off)   = 106.6 mm
    L1 숄더→엘보우                = 180 mm
    L2 엘보우→리스트               = 220 mm
    L3 리스트→TCP                 = 220 mm

    Case C 조인트 오프셋 (z축):
      shoulder_lift : -37.7 mm
      elbow         : +18.8 mm
      wrist         : -31.3 mm
      gripper       : +38 mm

  조인트 리미트:
    기존에 이 파일에 하드코딩돼 있던 가정치(base ±180°, shoulder 0~120°,
    elbow -90~+20°, wrist ±120°, gripper ±135° 등)는 전부 실측 인코더 기준
    리미트로 대체되었다. 실제 <limit> 값은 config/joint_calibration.yaml의
    raw_min/raw_max/zero_offset을 아래 보정식으로 계산해서 사용한다:

      actual_joint_angle = raw_encoder_angle - zero_offset
      actual_limit       = raw_limit         - zero_offset

    zero_offset은 아직 실측 전이라 joint_calibration.yaml에 전부 0.0
    placeholder로 들어있다(TODO(zero-offset)). 실측 후에는 그 yaml 파일만
    갱신하면 되고, 이 xacro는 손댈 필요 없다.

  TODO(home-pose): 각 조인트의 기본자세(홈 포지션, 현재는 SRDF group_state
  "home"에서 전부 actual=0으로 둠)는 아직 CATIA 확인 전 플레이스홀더다.
  TODO(base-pan-axis): base_rotate_joint의 회전축 방향/장착 orientation은
  CATIA로 재확인 필요.
  ============================================================
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="army_manipulator" params="prefix parent use_mock_hardware:=true use_mesh:=false *origin">

    <!-- ========== 치수 파라미터 ========== -->
    <xacro:property name="sh_off"   value="0.1616"/>  <!-- base_link -> shoulder_pan_link -->
    <xacro:property name="L1"       value="0.180"/>   <!-- shoulder -> elbow -->
    <xacro:property name="L2"       value="0.220"/>   <!-- elbow -> wrist -->
    <xacro:property name="L3"       value="0.220"/>   <!-- wrist -> tcp (gripper 포함) -->
    <xacro:property name="off_shoulder" value="-0.0377"/>
    <xacro:property name="off_elbow"    value="0.0188"/>
    <xacro:property name="off_wrist"    value="-0.0313"/>
    <xacro:property name="off_gripper"  value="0.038"/>

    <!-- ========== 관절 영점 보정(zero-offset) 리미트 ==========
         config/joint_calibration.yaml의 raw_min/raw_max/zero_offset을 읽어
         actual_limit = raw_limit - zero_offset 을 미리 계산해 둔다.
         (xacro는 launch마다 새로 처리되므로, 이 yaml만 갱신하면 URDF 소스를
         고치지 않아도 다음 실행부터 바로 반영된다.) -->
    <xacro:arg name="joint_calibration_file"
               default="$(find army_manipulator_description)/config/joint_calibration.yaml"/>
    <xacro:property name="joint_calibration_file" value="$(arg joint_calibration_file)"/>
    <xacro:property name="joint_calib" value="${xacro.load_yaml(joint_calibration_file)}"/>

    <xacro:property name="base_rotate_limit_lower"
                     value="${joint_calib['joints']['base_rotate_joint']['raw_min'] - joint_calib['joints']['base_rotate_joint']['zero_offset']}"/>
    <xacro:property name="base_rotate_limit_upper"
                     value="${joint_calib['joints']['base_rotate_joint']['raw_max'] - joint_calib['joints']['base_rotate_joint']['zero_offset']}"/>
    <xacro:property name="shoulder_lift_limit_lower"
                     value="${joint_calib['joints']['shoulder_lift_joint']['raw_min'] - joint_calib['joints']['shoulder_lift_joint']['zero_offset']}"/>
    <xacro:property name="shoulder_lift_limit_upper"
                     value="${joint_calib['joints']['shoulder_lift_joint']['raw_max'] - joint_calib['joints']['shoulder_lift_joint']['zero_offset']}"/>
    <xacro:property name="elbow_limit_lower"
                     value="${joint_calib['joints']['elbow_joint']['raw_min'] - joint_calib['joints']['elbow_joint']['zero_offset']}"/>
    <xacro:property name="elbow_limit_upper"
                     value="${joint_calib['joints']['elbow_joint']['raw_max'] - joint_calib['joints']['elbow_joint']['zero_offset']}"/>
    <xacro:property name="wrist_limit_lower"
                     value="${joint_calib['joints']['wrist_joint']['raw_min'] - joint_calib['joints']['wrist_joint']['zero_offset']}"/>
    <xacro:property name="wrist_limit_upper"
                     value="${joint_calib['joints']['wrist_joint']['raw_max'] - joint_calib['joints']['wrist_joint']['zero_offset']}"/>
    <xacro:property name="gripper_limit_lower"
                     value="${joint_calib['joints']['gripper_joint']['raw_min'] - joint_calib['joints']['gripper_joint']['zero_offset']}"/>
    <xacro:property name="gripper_limit_upper"
                     value="${joint_calib['joints']['gripper_joint']['raw_max'] - joint_calib['joints']['gripper_joint']['zero_offset']}"/>

    <!-- ========== parent -> base_link ========== -->
    <joint name="${prefix}world_to_base" type="fixed">
      <parent link="${parent}"/>
      <child  link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- base_link: 암 마운팅 플레이트 (구동부 상면) -->
    <link name="${prefix}base_link">
      <!-- mesh 파일은 사용자가 추후 추가 예정. scale은 CATIA(mm) -> URDF(m) 변환용. -->
      <xacro:if value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="petg_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><box size="0.100 0.100 0.008"/></geometry>
          <material name="petg_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><box size="0.100 0.100 0.008"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="2.5e-4" ixy="0" ixz="0"
                 iyy="2.5e-4" iyz="0" izz="5.0e-4"/>
      </inertial>
    </link>

    <!-- ========== base_link -> shoulder_pan_link ========== -->
    <!-- XH540-W270-T | Z축 회전 (베이스 선회) -->
    <joint name="${prefix}base_rotate_joint" type="revolute">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}shoulder_pan_link"/>
      <origin xyz="0 0 ${sh_off}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <!-- 실측 인코더 리미트(raw_min/raw_max) - zero_offset. config/joint_calibration.yaml -->
      <limit lower="${base_rotate_limit_lower}" upper="${base_rotate_limit_upper}"
             effort="3.1" velocity="2.618"/>
      <!-- XH540 stall torque 3.1 Nm @ 12V, no-load speed 25 RPM = 2.618 rad/s -->
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <!-- shoulder_pan_link: XH540 모터 바디 -->
    <link name="${prefix}shoulder_pan_link">
      <xacro:if value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/shoulder_pan_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="motor_dark"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/shoulder_pan_link.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><cylinder radius="0.028" length="0.055"/></geometry>
          <material name="motor_dark"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><cylinder radius="0.028" length="0.055"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.202"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1.3e-4" ixy="0" ixz="0"
                 iyy="1.3e-4" iyz="0" izz="8.0e-5"/>
      </inertial>
    </link>

    <!-- ========== shoulder_pan_link -> upper_arm_link ========== -->
    <!-- RMD-X8-120 | Y축 회전 (숄더 피치), Case C 오프셋 z=-37.7mm -->
    <joint name="${prefix}shoulder_lift_joint" type="revolute">
      <parent link="${prefix}shoulder_pan_link"/>
      <child  link="${prefix}upper_arm_link"/>
      <origin xyz="0 0 ${off_shoulder}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- 실측 인코더 리미트(raw_min/raw_max) - zero_offset. config/joint_calibration.yaml -->
      <limit lower="${shoulder_lift_limit_lower}" upper="${shoulder_lift_limit_upper}"
             effort="120.0" velocity="1.047"/>
      <!-- RMD-X8-120 peak torque 120 Nm, no-load speed ~10 RPM = 1.047 rad/s -->
      <dynamics damping="1.0" friction="0.1"/>
    </joint>

    <!-- upper_arm_link: CFRP 20x20x2T, L1 = 180mm -->
    <link name="${prefix}upper_arm_link">
      <xacro:if value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/upper_arm_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="cfrp"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/upper_arm_link.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="${L1/2} 0 0" rpy="0 1.5708 0"/>
          <geometry><box size="0.020 0.020 ${L1}"/></geometry>
          <material name="cfrp"/>
        </visual>
        <collision>
          <origin xyz="${L1/2} 0 0" rpy="0 0 0"/>
          <geometry><box size="${L1} 0.022 0.022"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.08"/>
        <origin xyz="${L1/2} 0 0"/>
        <inertia ixx="6.0e-6" ixy="0" ixz="0"
                 iyy="2.2e-4" iyz="0" izz="2.2e-4"/>
      </inertial>
    </link>

    <!-- ========== upper_arm_link -> forearm_link ========== -->
    <!-- RMD-X6-60 | Y축 회전 (엘보우 피치), x=L1, Case C 오프셋 z=+18.8mm -->
    <joint name="${prefix}elbow_joint" type="revolute">
      <parent link="${prefix}upper_arm_link"/>
      <child  link="${prefix}forearm_link"/>
      <origin xyz="${L1} 0 ${off_elbow}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- 실측 인코더 리미트(raw_min/raw_max) - zero_offset. config/joint_calibration.yaml -->
      <limit lower="${elbow_limit_lower}" upper="${elbow_limit_upper}"
             effort="60.0" velocity="1.571"/>
      <!-- RMD-X6-60 peak torque 60 Nm -->
      <dynamics damping="0.5" friction="0.05"/>
    </joint>

    <!-- forearm_link: CFRP 20x20x2T, L2 = 220mm -->
    <link name="${prefix}forearm_link">
      <xacro:if value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/forearm_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="cfrp"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/forearm_link.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="${L2/2} 0 0" rpy="0 1.5708 0"/>
          <geometry><box size="0.020 0.020 ${L2}"/></geometry>
          <material name="cfrp"/>
        </visual>
        <collision>
          <origin xyz="${L2/2} 0 0" rpy="0 0 0"/>
          <geometry><box size="${L2} 0.022 0.022"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.10"/>
        <origin xyz="${L2/2} 0 0"/>
        <inertia ixx="7.3e-6" ixy="0" ixz="0"
                 iyy="4.0e-4" iyz="0" izz="4.0e-4"/>
      </inertial>
    </link>

    <!-- ========== forearm_link -> wrist_link ========== -->
    <!-- RMD-X4-36 | Y축 회전 (리스트 피치), x=L2, Case C 오프셋 z=-31.3mm -->
    <joint name="${prefix}wrist_joint" type="revolute">
      <parent link="${prefix}forearm_link"/>
      <child  link="${prefix}wrist_link"/>
      <origin xyz="${L2} 0 ${off_wrist}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- 실측 인코더 리미트(raw_min/raw_max) - zero_offset. config/joint_calibration.yaml -->
      <limit lower="${wrist_limit_lower}" upper="${wrist_limit_upper}"
             effort="36.0" velocity="2.618"/>
      <!-- RMD-X4-36 peak torque 36 Nm -->
      <dynamics damping="0.2" friction="0.02"/>
    </joint>

    <!-- wrist_link: 리스트 모터 하우징 (PETG) -->
    <link name="${prefix}wrist_link">
      <xacro:if value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/wrist_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="petg_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/wrist_link.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><cylinder radius="0.022" length="0.038"/></geometry>
          <material name="petg_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><cylinder radius="0.022" length="0.038"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.09"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="5.0e-5" ixy="0" ixz="0"
                 iyy="5.0e-5" iyz="0" izz="3.0e-5"/>
      </inertial>
    </link>

    <!-- ========== wrist_link -> gripper_base_link ========== -->
    <!-- MX-106T | Z축 회전 (그리퍼 회전/핑거 구동), Case C 오프셋 z=+38mm -->
    <joint name="${prefix}gripper_joint" type="revolute">
      <parent link="${prefix}wrist_link"/>
      <child  link="${prefix}gripper_base_link"/>
      <origin xyz="0 0 ${off_gripper}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <!-- 실측 인코더 리미트(raw_min/raw_max) - zero_offset. config/joint_calibration.yaml -->
      <limit lower="${gripper_limit_lower}" upper="${gripper_limit_upper}"
             effort="8.4" velocity="3.665"/>
      <!-- MX-106T stall torque 8.4 Nm @ 12V, no-load 45 RPM = 4.712 rad/s -->
      <dynamics damping="0.05" friction="0.01"/>
    </joint>

    <!-- gripper_base_link: EE 바디 + 핑거 어셈블리 -->
    <link name="${prefix}gripper_base_link">
      <xacro:if value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/visual/gripper_base_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="petg_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://army_manipulator_description/meshes/collision/gripper_base_link.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual>
          <origin xyz="0 0 0.110" rpy="0 0 0"/>
          <geometry><box size="0.040 0.095 0.182"/></geometry>
          <!-- 너비 95mm = 95x95x95 타겟 기준 최대 개구량 -->
          <material name="petg_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0.110" rpy="0 0 0"/>
          <geometry><box size="0.040 0.095 0.182"/></geometry>
        </collision>
      </xacro:unless>
      <inertial>
        <mass value="0.15"/>
        <origin xyz="0 0 0.110"/>
        <inertia ixx="5.0e-4" ixy="0" ixz="0"
                 iyy="5.0e-4" iyz="0" izz="1.0e-4"/>
      </inertial>
    </link>

    <!-- ========== gripper_base_link -> tcp_link (fixed) ========== -->
    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child  link="${prefix}tcp_link"/>
      <origin xyz="0 0 0.182" rpy="0 0 0"/>
    </joint>

    <!-- tcp_link: 툴 센터 포인트 -->
    <link name="${prefix}tcp_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.005"/></geometry>
        <material name="tcp_red"/>
      </visual>
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-7" ixy="0" ixz="0"
                 iyy="1e-7" iyz="0" izz="1e-7"/>
      </inertial>
    </link>

    <xacro:army_manipulator_ros2_control prefix="${prefix}" use_mock_hardware="${use_mock_hardware}"/>

  </xacro:macro>

</robot>
